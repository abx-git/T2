# --- diagrams.net-Modell: App auf dem Server, Board-JSON auf dem Rechner des Nutzers ---
# Host liefert nur die Web-App. Im Browser: „Daten“ → Arbeitsdatei → Datei öffnen.
# HTTPS am Host nötig (Chrome/Edge File-System-API). Server-Board unten aus lassen:
# T2_SERVER_BOARD_ENABLED=0
#
# --- Optional: Server-Board (JSON auf dem Host, Login per Session-Cookie) ---
# T2_SERVER_BOARD_ENABLED=1
T2_SESSION_SECRET=change-me-use-long-random-string
T2_AUTH_USERNAME=admin
T2_AUTH_PASSWORD=change-me
# Optional: absoluter oder relativer Pfad (Standard: ./data/t2-board.json)
# T2_BOARD_FILE_PATH=./data/t2-board.json
# Optional: Pfad zur Ops-Datei (Standard: gleicher Ordner, Suffix -ops.json)
# T2_BOARD_OPS_FILE_PATH=./data/t2-board-ops.json
